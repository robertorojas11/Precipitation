# Google Earth Engine & Google Cloud Authentication
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/gcp_credentials.json
GOOGLE_DRIVE_CREDENTIALS=path/to/your/drive_credentials.json
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# GEE Export Configuration
GEE_DRIVE_FOLDER=Precipitation_Exports

# Local Paths
LOCAL_DATA_DIR=/mnt/data-r2/RobertoRojas/downscaling
RAW_DATA_DIR=/mnt/data-r2/RobertoRojas/downscaling/raw
PROCESSED_DATA_DIR=/mnt/data-r2/RobertoRojas/downscaling/processed
# v2-generative acquisition root (ERA5 cp/lsp, IMERG, region-scoped Oya).
# Defaults to $RAW_DATA_DIR/v2_generative if unset.
V2_RAW_DATA_DIR=/mnt/data-r2/RobertoRojas/downscaling/raw/v2_generative

# Region shapefiles (tropical-cyclone basin polygons, see docs/DATA_SOURCES.md)
ATLANTICO_SHP_PATH=/mnt/data-r2/RobertoRojas/downscaling/shape_files/atlantico_shp/atlantico_shp_grande.shp
PACIFICO_SHP_PATH=/mnt/data-r2/RobertoRojas/downscaling/shape_files/pacifico_shp/pacifico_shp_grande.shp

# Copernicus CDS (pure ERA5 cp/lsp acquisition, src/data_extraction/era5_cds.py)
# Get a key from https://cds.climate.copernicus.eu/ (Your profile -> API key).
# Alternatively, place both values in ~/.cdsapirc instead of here.
CDSAPI_URL=
CDSAPI_KEY=

# NASA Earthdata (IMERG acquisition, src/data_extraction/imerg.py)
# A bearer token from https://urs.earthdata.nasa.gov/ is preferred; a
# username/password pair or a ~/.netrc entry also work.
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Training Parameters
CUDA_DEVICE=0
BATCH_SIZE=16
LEARNING_RATE=0.0002

# Experiment Flags
# TARGET_PIPELINE=chirps # or oya
